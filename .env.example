GRAPHQL_ENDPOINT="http://example.test/wp/graphql"
WORDPRESS_URL="http://example.test"
PUBLIC_SITE_URL="https://example.com"

# Optional: CDN URL for asset rewriting (leave empty to use WordPress URLs)
CDN_URL=""

# WordPress menu slug to query
MENU_SLUG="main-menu"

# Optional: WordPress authentication for preview/draft content
WP_USERNAME=""
WP_APP_PW=""

# Optional: Brevo newsletter signup (footer form). Without the key and list ID
# the form is hidden. Set a double opt-in template ID to send confirmation emails.
BREVO_API_KEY=""
BREVO_LIST_ID=""
BREVO_DOI_TEMPLATE_ID=""

# Optional: Cloudflare Turnstile (invisible widget) bot check on the signup
# form. Set both or neither: with only the secret set, every signup is refused.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional: protects the scheduled /api/cron/* endpoints. Vercel sends it as a
# Bearer token when set in the project's environment variables.
CRON_SECRET=""

# Contact widget: messages are emailed to us through Brevo (uses BREVO_API_KEY).
# CONTACT_FROM_EMAIL must be a sender verified in Brevo. Without it the widget
# still works: it hands the visitor an email link carrying their answers.
CONTACT_FROM_EMAIL=""
# Where messages go. Defaults to welikeyou@nhtbl.studio.
CONTACT_TO_EMAIL=""
